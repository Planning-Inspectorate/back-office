                    <p id="filter1-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> Webfilter must be 100
                        characters or less</p>
                    <textarea class="govuk-textarea govuk-textarea--error"
                    id="filter1" name="filter1" rows="5" aria-describedby="filter1-error">xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx</textarea>
                </div>
                <button type="submit" class="govuk-button" data-module="govuk-button">Save and return</button>
            </form>
        </div>
    </div>
</main>"
`;

