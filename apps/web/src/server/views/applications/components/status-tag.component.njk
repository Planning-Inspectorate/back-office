{# Project status tag macro #}

{% macro statusTag(status) %}
	{% set statusTagColor = '' %}
	{% set statusLabel = status %}

	{% switch (status) %}
		{% case 'Decision' %}
			{% set statusTagColor = 'pink' %}
		{% case 'Post-Decision' %}
			{% set statusTagColor = 'grey' %}
		{% case 'Pre-Application' %}
			{% set statusTagColor = 'green' %}
		{% case 'Acceptance' %}
			{% set statusTagColor = 'turquoise' %}
		{% case 'Pre-Examination' %}
			{% set statusTagColor = 'blue' %}
		{% case 'Examination' %}
			{% set statusTagColor = 'purple' %}
		{% case 'Recommendation' %}
			{% set statusTagColor = 'yellow' %}
		{% case 'Withdrawn' %}
			{% set statusTagColor = 'orange' %}
		{% case 'Published' %}
			{% set statusTagColor = 'green' %}
		{% case 'Unpublished' %}
			{% set statusTagColor = 'grey' %}
		{% case 'In progress' %}
			{% set statusTagColor = 'blue' %}
	{% endswitch %}

	<strong class="govuk-tag govuk-tag--{{statusTagColor}} pins-tag--no-max-width">{{ statusLabel }}</strong>
{% endmacro %}
