{% extends "../layouts/applications.layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "applications/components/pagination/results-per-page.component.njk" import uiPageSizeInformation, uiPaginationLinks %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% set pageTitle = "Unpublish category " + sectionHeading + " from the examination library - " + case.title + " - NSIP applications" %}

{% block pageTitle %}{{ pageTitle }}{% endblock %}

{% block beforeContent %}
	<aside>
		{{ govukBackLink({
			text: "Back",
			href: backLink
		}) }}
	</aside>
{% endblock %}

{% block pageHeading %}
	<h1 class="govuk-heading-l">
		Unpublish {{ sectionHeading }} from the examination library
	</h1>
{% endblock %}

{% block pageContent %}
	<p class="govuk-body">
		Unpublishing this category will remove it from the examination library, but examination library reference numbers will remain assigned and cannot be changed.
	</p>

	{{ uiPageSizeInformation(pagination) }}

	<h2>{{ sectionHeading }}</h2>

	{{ govukTable(unpublishTable) }}

	{{ uiPaginationLinks(pagination) }}

	{{ govukWarningText({
		text: 'Unpublishing will remove only the category from the examination library, it will not unpublish any associated documents.',
		iconFallbackText: "Warning"
	}) }}

	<form method="post">
		{{ govukButton({
			text: "Unpublish from examination library",
			type: "submit"
		}) }}
	</form>
{% endblock %}
